{
  "name": "music",
  "private": true,
  "main": "index.ts",
  "version": "3.5.0",
  "description": "A Nothing inspired music player.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/MissingCore/Music"
  },
  "author": "cyanChill",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android --variant debugOptimized",
    "android:prod": "expo run:android --variant release",
    "atlas": "npx expo export --platform android && npx expo-atlas",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "circular-dep": "npx dpdm@4.0.1 ./src/* --circular --exit-code circular:1 --warning=false",
    "db:generate": "drizzle-kit generate",
    "sync:licenses": "license-checker-rseidelsohn --production --depth=0 --excludePrivatePackages --clarificationsFile ./scripts/licenses/licenseClarification.json --customPath ./scripts/licenses/customLicenseFormat.json --json | node ./scripts/licenses/updateLicenses.mjs",
    "release": "git pull && python ./scripts/release/release_bump.py"
  },
  "dependencies": {
    "@boterop/react-native-background-timer": "2.6.0",
    "@legendapp/list": "3.3.10",
    "@lodev09/react-native-true-sheet": "3.4.2",
    "@missingcore/react-native-actual-path": "0.1.0",
    "@missingcore/react-native-audio-analyzer": "3.2.0-beta.5",
    "@missingcore/react-native-metadata-retriever": "4.0.0-beta.1",
    "@paralleldrive/cuid2": "3.3.0",
    "@react-navigation/material-top-tabs": "7.6.17",
    "@react-navigation/native": "7.3.18",
    "@react-navigation/native-stack": "7.18.10",
    "@rn-primitives/portal": "1.5.3",
    "@sentry/react-native": "8.24.0",
    "@tanstack/react-query": "5.102.8",
    "@zoontek/react-native-navigation-bar": "2.0.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "expo": "57.0.19",
    "expo-drizzle-studio-plugin": "0.2.1",
    "expo-file-system": "57.0.6",
    "expo-font": "57.0.3",
    "expo-image": "57.0.4",
    "expo-image-manipulator": "57.0.15",
    "expo-image-picker": "57.0.15",
    "expo-linear-gradient": "57.0.1",
    "expo-sqlite": "57.0.2",
    "i18next": "26.4.1",
    "intl-pluralrules": "2.0.1",
    "jotai": "2.20.3",
    "react": "19.2.3",
    "react-i18next": "17.0.13",
    "react-native": "0.86.3",
    "react-native-android-widget": "0.22.1",
    "react-native-audio-browser": "github:MissingCore/react-native-audio-browser#05f7af440edc29222d12a0acc58234f5cb51433d",
    "react-native-bootsplash": "7.3.2",
    "react-native-gesture-handler": "3.2.1",
    "react-native-keyboard-controller": "1.22.4",
    "react-native-markdown-renderer": "4.1.1",
    "react-native-nano-icons": "0.2.1",
    "react-native-nitro-modules": "0.37.1",
    "react-native-pager-view": "8.0.4",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "5.9.1",
    "react-native-screens": "4.27.0",
    "react-native-svg": "15.15.5",
    "react-native-worklets": "0.12.1",
    "tailwind-merge": "3.6.0",
    "uniwind": "1.11.0",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@tanstack/eslint-plugin-query": "5.102.8",
    "@types/react": "19.2.18",
    "babel-plugin-inline-import": "3.0.0",
    "babel-plugin-transform-remove-console": "6.9.4",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-expo": "57.0.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-drizzle": "0.2.3",
    "eslint-plugin-prettier": "5.5.6",
    "expo-atlas": "0.4.3",
    "expo-build-properties": "57.0.16",
    "license-checker-rseidelsohn": "4.4.2",
    "neatjson": "0.10.6",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "expo-splash-screen"
      ]
    }
  },
  "reanimated": {
    "staticFeatureFlags": {
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": false,
      "DISABLE_COMMIT_PAUSING_MECHANISM": false
    }
  }
}
