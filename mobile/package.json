{
  "name": "music",
  "private": true,
  "main": "index.ts",
  "version": "3.8.0",
  "description": "A Nothing inspired music player.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/MissingCore/Music"
  },
  "author": "cyanChill",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android --variant debugOptimized",
    "android:prod": "expo run:android --variant release",
    "atlas": "npx expo export --platform android && npx expo-atlas",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "circular-dep": "npx dpdm@4.0.1 ./src/* --circular --exit-code circular:1 --warning=false",
    "db:generate": "drizzle-kit generate",
    "sync:licenses": "license-checker-rseidelsohn --production --depth=0 --excludePrivatePackages --clarificationsFile ./scripts/licenses/licenseClarification.json --customPath ./scripts/licenses/customLicenseFormat.json --json | node ./scripts/licenses/updateLicenses.mjs",
    "release": "git pull && python ./scripts/release/release_bump.py"
  },
  "dependencies": {
    "@boterop/react-native-background-timer": "2.6.0",
    "@howincodes/expo-dynamic-app-icon": "3.0.2",
    "@legendapp/list": "3.7.0",
    "@lodev09/react-native-true-sheet": "4.0.0-beta.25",
    "@missingcore/react-native-actual-path": "0.1.0",
    "@missingcore/react-native-audio-analyzer": "3.2.0-beta.5",
    "@missingcore/react-native-metadata-retriever": "4.0.0-beta.2",
    "@paralleldrive/cuid2": "3.3.0",
    "@react-navigation/material-top-tabs": "8.0.0-alpha.56",
    "@react-navigation/native": "8.0.0-alpha.51",
    "@react-navigation/native-stack": "8.0.0-alpha.59",
    "@rn-primitives/portal": "1.5.3",
    "@sentry/react-native": "8.32.0",
    "@tanstack/react-query": "5.105.0",
    "@zoontek/react-native-navigation-bar": "2.0.2",
    "clsx": "2.1.1",
    "cva": "1.0.0-beta.12",
    "drizzle-orm": "0.45.4",
    "expo": "58.0.21",
    "expo-drizzle-studio-plugin": "0.2.1",
    "expo-file-system": "58.0.13",
    "expo-font": "58.0.11",
    "expo-image": "58.0.18",
    "expo-image-manipulator": "58.0.16",
    "expo-image-picker": "58.0.10",
    "expo-linear-gradient": "58.0.3",
    "expo-sharing": "58.0.21",
    "expo-sqlite": "58.0.14",
    "i18next": "26.5.11",
    "intl-pluralrules": "2.0.1",
    "jotai": "3.0.1",
    "react": "19.3.0",
    "react-i18next": "17.1.9",
    "react-is": "19.3.0",
    "react-keyed-flatten-children": "5.1.4",
    "react-native": "0.88.1",
    "react-native-android-widget": "0.25.0",
    "react-native-audio-browser": "github:MissingCore/react-native-audio-browser#05f7af440edc29222d12a0acc58234f5cb51433d",
    "react-native-bootsplash": "7.3.4",
    "react-native-easing-gradient": "1.1.1",
    "react-native-gesture-handler": "3.4.0",
    "react-native-keyboard-controller": "1.22.9",
    "react-native-markdown-renderer": "4.1.1",
    "react-native-material-palette": "0.2.0",
    "react-native-nano-icons": "1.0.1",
    "react-native-nitro-modules": "0.37.1",
    "react-native-pager-view": "8.0.4",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.0",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.1",
    "tailwind-merge": "3.7.0",
    "uniwind": "1.13.1",
    "valibot": "1.5.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@tanstack/eslint-plugin-query": "5.105.0",
    "@types/react": "19.3.0",
    "babel-plugin-inline-import": "3.0.0",
    "babel-plugin-transform-remove-console": "6.9.4",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-expo": "58.0.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-drizzle": "0.2.3",
    "eslint-plugin-prettier": "5.5.7",
    "expo-atlas": "0.5.0",
    "expo-build-properties": "58.0.11",
    "license-checker-rseidelsohn": "4.4.2",
    "neatjson": "0.10.6",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "expo-splash-screen"
      ]
    }
  },
  "react-navigation": {
    "material-symbols": {
      "fonts": []
    }
  },
  "reanimated": {
    "staticFeatureFlags": {
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": false,
      "DISABLE_COMMIT_PAUSING_MECHANISM": false
    }
  }
}
